rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasEmail() {
      return isAuthenticated() &&
             'email' in request.auth.token &&
             request.auth.token.email is string;
    }

    function isEmailVerified() {
      return hasEmail() &&
             request.auth.token.get('email_verified', false) == true;
    }

    function currentUserExists() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isBlocked() {
      return currentUserExists() &&
             currentUserData().get('blocked', false) == true &&
             (currentUserData().get('blockedUntil', 0) == 0 ||
              currentUserData().get('blockedUntil', 0) > request.time.toMillis());
    }

    function isMuted() {
      return currentUserExists() &&
             currentUserData().get('muted', false) == true &&
             (currentUserData().get('mutedUntil', 0) == 0 ||
              currentUserData().get('mutedUntil', 0) > request.time.toMillis());
    }

    function isOwnerBootstrap() {
      return isEmailVerified() &&
             request.auth.token.email.lower() in ['konami123mw@gmail.com', 'zaim9002@gmail.com'];
    }

    // Admin privilege verified strictly from admins/{lowercase_email} allowlist (no role field on users)
    function isAdmin() {
      return isAuthenticated() && !isBlocked() && (
        isOwnerBootstrap() ||
        (isEmailVerified() && (
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) ||
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
        ))
      );
    }

    function isValidMediaUrl(val, allowGif) {
      return val is string &&
             val.size() <= 220000 && (
               val == '' ||
               (val.size() >= 8 && val[0:8] == 'https://') ||
               (val.size() >= 22 && val[0:22] == 'data:image/webp;base64') ||
               (val.size() >= 21 && val[0:21] == 'data:image/png;base64') ||
               (val.size() >= 22 && val[0:22] == 'data:image/jpeg;base64') ||
               (val.size() >= 21 && val[0:21] == 'data:image/jpg;base64') ||
               (allowGif && val.size() >= 21 && val[0:21] == 'data:image/gif;base64')
             );
    }

    function isValidHttpsLink(val) {
      return val is string && val.size() > 8 && val.size() <= 200 && val[0:8] == 'https://';
    }

    function isValidOptionalHttpsUrl(val, maxLen) {
      return val is string && val.size() <= maxLen && (val == '' || (val.size() > 8 && val[0:8] == 'https://'));
    }

    function isValidLinksList(links) {
      return links is list &&
             links.size() <= 3 &&
             (links.size() == 0 || isValidHttpsLink(links[0])) &&
             (links.size() <= 1 || isValidHttpsLink(links[1])) &&
             (links.size() <= 2 || isValidHttpsLink(links[2]));
    }

    function isValidAccent(val) {
      return val is string && (val == '' || val.matches('^#[0-9A-Fa-f]{6}$'));
    }

    function isValidUsernameValue(val) {
      return val is string && (val == '' || val.matches('^[a-z0-9_]{3,20}$'));
    }

    function nonAdminCanUseFrameData(fid, frameData, userData) {
      return frameData.get('access', 'everyone') == 'everyone' ||
             (frameData.get('access', 'everyone') == 'assigned' && fid in userData.get('frameAssigned', []));
    }

    function canUseFrame(fid, userData) {
      return fid is string && (
        fid == '' ||
        (
          fid.matches('^[a-zA-Z0-9_-]{2,48}$') &&
          exists(/databases/$(database)/documents/frames/$(fid)) &&
          nonAdminCanUseFrameData(fid, get(/databases/$(database)/documents/frames/$(fid)).data, userData)
        )
      );
    }

    // Admins allowlist (strictly owner/admin-managed writes)
    match /admins/{email} {
      allow get: if isAdmin() || (
        hasEmail() &&
        request.auth.token.email.lower() == email.lower()
      );
      allow list: if isAdmin();
      allow write: if isOwnerBootstrap() || isAdmin();
    }

    // Personal GitHub token per approved admin (strictly private to owner uid)
    match /adminTokens/{uid} {
      allow get, create, update, delete: if isAdmin() && request.auth.uid == uid;
      allow list: if false;
    }

    // Shared GitHub token (admins read-only, owner/admin write)
    match /config/github {
      allow read: if isAdmin();
      allow write: if isOwnerBootstrap() || isAdmin();
    }

    // Public support / admin UIDs directory (no emails or tokens)
    match /config/support {
      allow read: if true;
      allow write: if isAdmin();
    }

    // App Designer Live Global Theme Config (public read, admins write)
    match /config/appTheme {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Avatar Frames Catalog (public read, admins write)
    match /frames/{frameId} {
      allow read: if true;
      allow create, update: if isAdmin() &&
                            frameId.matches('^[a-zA-Z0-9_-]{2,48}$') &&
                            request.resource.data.name is string &&
                            request.resource.data.name.size() > 0 &&
                            request.resource.data.name.size() <= 48 &&
                            request.resource.data.type in ['solid', 'gradient', 'conic', 'animated', 'pattern'] &&
                            request.resource.data.access in ['everyone', 'admins', 'owner', 'assigned'] &&
                            request.resource.data.get('colors', []) is list &&
                            request.resource.data.get('colors', []).size() <= 6;
      allow delete: if isAdmin();
    }

    // Club Moderation Config (categories, banned words, limits, allowed domains, maintenance mode)
    match /config/moderation {
      allow read: if true;
      allow write: if isAdmin();
    }

    // App Designer Version History (admins only)
    match /appThemeHistory/{historyId} {
      allow read, write: if isAdmin();
    }

    // Custom Saved Templates (admins only)
    match /templates/{templateId} {
      allow read, write: if isAdmin();
    }

    // Hashed email -> uid lookup (zero email exposure; no listing)
    match /emailLookup/{emailHash} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create, update: if isAuthenticated() &&
                            emailHash.matches('^[a-f0-9]{64}$') &&
                            request.resource.data.uid == request.auth.uid &&
                            !('email' in request.resource.data);
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // Unique @username reservation (exact get only, no directory listing)
    match /usernames/{uname} {
      allow get: if true;
      allow list: if false;
      allow create: if isAuthenticated() &&
                    !isBlocked() &&
                    request.resource.data.uid == request.auth.uid &&
                    uname.matches('^[a-z0-9_]{3,20}$');
      allow update: if isAuthenticated() &&
                    !isBlocked() &&
                    resource.data.uid == request.auth.uid &&
                    request.resource.data.uid == request.auth.uid &&
                    uname.matches('^[a-z0-9_]{3,20}$');
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // User Profiles (no role, no public email; admins manage verified badges, assigned frames, titles, name styling, blocking/muting)
    match /users/{userId} {
      allow read: if true;
      allow create: if isAdmin() || (
                    isAuthenticated() &&
                    request.auth.uid == userId &&
                    request.resource.data.uid == request.auth.uid &&
                    !('role' in request.resource.data) &&
                    !('email' in request.resource.data) &&
                    request.resource.data.get('blocked', false) == false &&
                    request.resource.data.get('blockedUntil', 0) == 0 &&
                    request.resource.data.get('muted', false) == false &&
                    request.resource.data.get('mutedUntil', 0) == 0 &&
                    request.resource.data.get('publisher', false) == false &&
                    request.resource.data.get('verified', false) == false &&
                    request.resource.data.get('badgeType', '') == '' &&
                    request.resource.data.get('badges', []) is list &&
                    request.resource.data.get('badges', []).size() == 0 &&
                    request.resource.data.get('frame', '') == '' &&
                    request.resource.data.get('frameId', '') == '' &&
                    request.resource.data.get('frameAssigned', []) is list &&
                    request.resource.data.get('frameAssigned', []).size() == 0 &&
                    request.resource.data.get('customTitle', '') == '' &&
                    request.resource.data.get('title', '') == '' &&
                    request.resource.data.get('profileGradient', '') == '' &&
                    request.resource.data.get('nameColor', '') == '' &&
                    request.resource.data.get('nameGradient', '') == '' &&
                    request.resource.data.get('nameFont', '') == '' &&
                    isValidUsernameValue(request.resource.data.get('username', '')) &&
                    isValidUsernameValue(request.resource.data.get('usernameLower', '')) &&
                    request.resource.data.get('displayName', '') is string &&
                    request.resource.data.get('displayName', '').size() <= 60 &&
                    request.resource.data.get('bio', '') is string &&
                    request.resource.data.get('bio', '').size() <= 150 &&
                    isValidLinksList(request.resource.data.get('links', [])) &&
                    isValidAccent(request.resource.data.get('profileAccent', '')) &&
                    request.resource.data.get('hideCommentsCount', false) is bool &&
                    request.resource.data.get('clubRulesAccepted', false) is bool &&
                    isValidMediaUrl(request.resource.data.get('photoURL', ''), false) &&
                    isValidMediaUrl(request.resource.data.get('bannerURL', ''), false));
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        !isBlocked() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'email', 'blocked', 'blockedUntil', 'muted', 'mutedUntil',
          'publisher', 'verified', 'badgeType', 'badges', 'frame', 'frameAssigned',
          'customTitle', 'title', 'profileGradient', 'nameColor', 'nameGradient',
          'nameFont', 'createdAt'
        ]) &&
        request.resource.data.get('uid', userId) == userId &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['frameId']) || canUseFrame(request.resource.data.frameId, resource.data)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName']) || (
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() <= 60
        )) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['bio']) || (
          request.resource.data.bio is string &&
          request.resource.data.bio.size() <= 150
        )) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['links']) || isValidLinksList(request.resource.data.links)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['profileAccent']) || isValidAccent(request.resource.data.profileAccent)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['hideCommentsCount']) || request.resource.data.hideCommentsCount is bool) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['clubRulesAccepted']) || request.resource.data.clubRulesAccepted is bool) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoURL']) || isValidMediaUrl(request.resource.data.photoURL, false)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['bannerURL']) || isValidMediaUrl(request.resource.data.bannerURL, false)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['username']) || isValidUsernameValue(request.resource.data.username)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['usernameLower']) || isValidUsernameValue(request.resource.data.usernameLower))
      );
      allow delete: if isAdmin();

      // Personal chat & club block list managed strictly by account owner
      match /blockedUsers/{targetUid} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // 1-to-1 Member Conversations (convId = minUid + "_" + maxUid)
    // Strictly private to participants; admins may read a specific chat ONLY if a message in it was reported
    match /conversations/{convId} {
      function isConvParticipantData(data) {
        return (data.get('participants', []) is list && request.auth.uid in data.get('participants', [])) ||
               convId == request.auth.uid ||
               data.get('participantA', '') == request.auth.uid ||
               data.get('participantB', '') == request.auth.uid;
      }

      allow get: if isAuthenticated() && (
        resource == null ||
        isConvParticipantData(resource.data) ||
        (isAdmin() && resource.data.get('hasReportedMessage', false) == true)
      );
      allow list: if isAuthenticated() && (request.auth.uid in resource.data.participants);
      allow create: if isAuthenticated() &&
                    !isBlocked() &&
                    ('participants' in request.resource.data) &&
                    request.resource.data.participants is list &&
                    request.resource.data.participants.size() == 2 &&
                    request.resource.data.participants[0] is string &&
                    request.resource.data.participants[1] is string &&
                    request.resource.data.participants[0] != request.resource.data.participants[1] &&
                    (request.auth.uid in request.resource.data.participants) &&
                    ('participantA' in request.resource.data) &&
                    ('participantB' in request.resource.data) &&
                    request.resource.data.participantA is string &&
                    request.resource.data.participantB is string &&
                    request.resource.data.participantA in request.resource.data.participants &&
                    request.resource.data.participantB in request.resource.data.participants &&
                    request.resource.data.get('hasReportedMessage', false) == false;
      allow update: if isAuthenticated() && (
        (
          !isBlocked() &&
          isConvParticipantData(resource.data) &&
          !(resource.data.get('hasReportedMessage', false) == true && request.resource.data.get('hasReportedMessage', false) == false) &&
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadBy', 'hasReportedMessage', 'lastMessage', 'lastAt', 'updatedAt']) ||
            (
              request.resource.data.get('participants', []) is list &&
              request.resource.data.participants.size() == 2 &&
              (request.auth.uid in request.resource.data.participants) &&
              (!(resource.data.get('participants', null) is list) || request.resource.data.participants == resource.data.participants)
            )
          )
        ) ||
        isAdmin()
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function parentConvExists() {
          return exists(/databases/$(database)/documents/conversations/$(convId));
        }
        function parentConv() {
          return get(/databases/$(database)/documents/conversations/$(convId)).data;
        }
        function isParentParticipant() {
          return parentConvExists() && isConvParticipantData(parentConv());
        }
        function peerUidFromParent() {
          return (parentConv().get('participantA', '') == request.auth.uid && parentConv().get('participantB', '') is string && parentConv().get('participantB', '') != '')
            ? parentConv().participantB
            : ((parentConv().get('participantB', '') == request.auth.uid && parentConv().get('participantA', '') is string && parentConv().get('participantA', '') != '')
                ? parentConv().participantA
                : ((parentConv().get('participants', []) is list && parentConv().get('participants', []).size() >= 2)
                    ? (parentConv().participants[0] == request.auth.uid ? parentConv().participants[1] : parentConv().participants[0])
                    : ''));
        }
        function notBlockedByPeer() {
          return peerUidFromParent() == '' ||
                 !exists(/databases/$(database)/documents/users/$(peerUidFromParent())/blockedUsers/$(request.auth.uid));
        }

        allow read: if isAuthenticated() && (
          isParentParticipant() ||
          (isAdmin() && parentConvExists() && parentConv().get('hasReportedMessage', false) == true)
        );
        allow create: if isAuthenticated() &&
                      !isBlocked() &&
                      isParentParticipant() &&
                      request.resource.data.senderId == request.auth.uid &&
                      request.resource.data.text is string &&
                      request.resource.data.text.size() > 0 &&
                      request.resource.data.text.size() <= 1000 &&
                      notBlockedByPeer();
        allow update: if isAuthenticated() &&
                      isParentParticipant() &&
                      resource.data.get('senderId', '') != request.auth.uid &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
                      request.resource.data.read == true;
        allow delete: if isAdmin() || (isAuthenticated() && resource.data.get('senderId', '') == request.auth.uid);
      }
    }

    // Themes metadata, pin/overrides, ratings, comments, likes & 1-level replies
    match /themes/{themeId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isAuthenticated() &&
        !isBlocked() &&
        request.resource.data.keys().hasOnly(['ratingAvg', 'ratingCount', 'compatOk', 'compatFail', 'compatBrands', 'updatedAt']) &&
        request.resource.data.ratingAvg is number &&
        request.resource.data.ratingAvg >= 1 &&
        request.resource.data.ratingAvg <= 5 &&
        request.resource.data.ratingCount is number &&
        request.resource.data.ratingCount >= 0
      );
      allow update: if isAdmin() || (
        isAuthenticated() &&
        !isBlocked() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingAvg', 'ratingCount', 'compatOk', 'compatFail', 'compatBrands', 'updatedAt']) &&
        request.resource.data.ratingAvg is number &&
        request.resource.data.ratingAvg >= 1 &&
        request.resource.data.ratingAvg <= 5 &&
        request.resource.data.ratingCount is number &&
        request.resource.data.ratingCount >= 0 &&
        request.resource.data.compatOk is number &&
        request.resource.data.compatOk >= 0 &&
        request.resource.data.compatFail is number &&
        request.resource.data.compatFail >= 0 &&
        request.resource.data.compatBrands is map
      );
      allow delete: if isAdmin();

      match /compat/{uid} {
        allow read: if true;
        allow create, update: if isAuthenticated() &&
                              !isBlocked() &&
                              request.auth.uid == uid &&
                              request.resource.data.status in ['ok', 'fail'] &&
                              request.resource.data.model is string &&
                              request.resource.data.model.size() <= 80 &&
                              request.resource.data.osVersion is string &&
                              request.resource.data.osVersion.size() <= 50 &&
                              request.resource.data.brand is string &&
                              request.resource.data.brand.size() <= 50 &&
                              request.resource.data.get('reason', '') is string &&
                              request.resource.data.get('reason', '').size() <= 100 &&
                              request.resource.data.get('note', '') is string &&
                              request.resource.data.get('note', '').size() <= 200 &&
                              request.resource.data.updatedAt is int;
        allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == uid);
      }

      match /ratings/{uid} {
        allow read: if true;
        allow create, update: if isAuthenticated() &&
                              request.auth.uid == uid &&
                              !isBlocked() &&
                              request.resource.data.stars is number &&
                              request.resource.data.stars >= 1 &&
                              request.resource.data.stars <= 5;
        allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == uid && !isBlocked());
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
                      !isBlocked() &&
                      !isMuted() &&
                      request.resource.data.uid == request.auth.uid &&
                      request.resource.data.text is string &&
                      request.resource.data.text.size() > 0 &&
                      request.resource.data.text.size() <= 500;
        allow update: if isAdmin() || (
          isAuthenticated() &&
          !isBlocked() &&
          (
            (resource.data.uid == request.auth.uid &&
             !isMuted() &&
             request.resource.data.uid == resource.data.uid &&
             request.resource.data.text is string &&
             request.resource.data.text.size() > 0 &&
             request.resource.data.text.size() <= 500) ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'replyCount'])
          )
        );
        allow delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);

        match /likes/{uid} {
          allow read: if true;
          allow create, delete: if isAuthenticated() && !isBlocked() && request.auth.uid == uid;
        }

        match /replies/{replyId} {
          allow read: if true;
          allow create: if isAuthenticated() &&
                        !isBlocked() &&
                        !isMuted() &&
                        request.resource.data.uid == request.auth.uid &&
                        request.resource.data.text is string &&
                        request.resource.data.text.size() > 0 &&
                        request.resource.data.text.size() <= 500;
          allow update: if isAdmin() || (
            isAuthenticated() &&
            !isBlocked() &&
            (
              (resource.data.uid == request.auth.uid &&
               !isMuted() &&
               request.resource.data.uid == resource.data.uid &&
               request.resource.data.text is string &&
               request.resource.data.text.size() > 0 &&
               request.resource.data.text.size() <= 500) ||
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
            )
          );
          allow delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);

          match /likes/{uid} {
            allow read: if true;
            allow create, delete: if isAuthenticated() && !isBlocked() && request.auth.uid == uid;
          }
        }
      }
    }

    // Collection group index support for counting & moderating user comments
    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }

    // ==================== CLUB ("النادي") SOCIAL COMMUNITY ====================
    match /posts/{postId} {
      function isValidPostPoll(p) {
        return p == null || (
          p is map &&
          p.get('question', '') is string &&
          p.get('question', '').size() > 0 &&
          p.get('question', '').size() <= 200 &&
          p.get('options', []) is list &&
          p.get('options', []).size() >= 2 &&
          p.get('options', []).size() <= 4 &&
          p.get('totalVotes', 0) is int &&
          p.get('totalVotes', 0) >= 0
        );
      }

      allow read: if resource.data.status == 'visible' ||
                     isAdmin() ||
                     (isAuthenticated() && resource.data.authorUid == request.auth.uid);

      allow create: if isAuthenticated() &&
                    !isBlocked() &&
                    !isMuted() &&
                    request.resource.data.authorUid == request.auth.uid &&
                    request.resource.data.get('authorName', '') is string &&
                    request.resource.data.get('authorName', '').size() <= 60 &&
                    request.resource.data.get('text', '') is string &&
                    request.resource.data.get('text', '').size() <= 2000 &&
                    request.resource.data.get('category', '') is string &&
                    request.resource.data.get('category', '').size() > 0 &&
                    request.resource.data.get('category', '').size() <= 50 &&
                    isValidOptionalHttpsUrl(request.resource.data.get('videoUrl', ''), 500) &&
                    request.resource.data.get('videoDurationSec', 0) is int &&
                    request.resource.data.get('videoDurationSec', 0) >= 0 &&
                    request.resource.data.get('videoDurationSec', 0) <= 120 &&
                    request.resource.data.get('mediaCount', 0) is int &&
                    request.resource.data.get('mediaCount', 0) >= 0 &&
                    request.resource.data.get('mediaCount', 0) <= 4 &&
                    isValidPostPoll(request.resource.data.get('poll', null)) &&
                    request.resource.data.status == 'visible' &&
                    request.resource.data.likesCount == 0 &&
                    request.resource.data.commentsCount == 0 &&
                    request.resource.data.reportsCount == 0 &&
                    request.resource.data.engagementScore == 0 &&
                    request.resource.data.createdAt is int &&
                    request.resource.data.updatedAt is int &&
                    (isAdmin() || (
                      request.resource.data.get('pinned', false) == false &&
                      request.resource.data.get('isAnnouncement', false) == false &&
                      request.resource.data.get('commentsLocked', false) == false
                    ));

      allow update: if isAdmin() || (
        isAuthenticated() &&
        !isBlocked() &&
        request.resource.data.authorUid == resource.data.authorUid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (
          // 1) Author editing their own post content (protected counters/status untouched)
          (
            !isMuted() &&
            resource.data.authorUid == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'text', 'category', 'themeRef', 'themeSnapshot', 'videoUrl',
              'videoDurationSec', 'mediaCount', 'mentions', 'updatedAt'
            ]) &&
            request.resource.data.get('text', '') is string &&
            request.resource.data.get('text', '').size() <= 2000 &&
            request.resource.data.get('category', '') is string &&
            request.resource.data.get('category', '').size() > 0 &&
            request.resource.data.get('category', '').size() <= 50 &&
            isValidOptionalHttpsUrl(request.resource.data.get('videoUrl', ''), 500) &&
            request.resource.data.get('videoDurationSec', 0) is int &&
            request.resource.data.get('videoDurationSec', 0) <= 120 &&
            request.resource.data.get('mediaCount', 0) is int &&
            request.resource.data.get('mediaCount', 0) <= 4
          ) ||
          // 2) Likes / reactions counter update (+/-1 likesCount, +/-2 engagementScore)
          (
            resource.data.status == 'visible' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'likesCount', 'reactions', 'engagementScore', 'updatedAt'
            ]) &&
            request.resource.data.likesCount is int &&
            request.resource.data.likesCount >= 0 &&
            request.resource.data.likesCount <= resource.data.likesCount + 1 &&
            request.resource.data.likesCount >= resource.data.likesCount - 1 &&
            request.resource.data.engagementScore is int &&
            request.resource.data.engagementScore >= 0 &&
            request.resource.data.engagementScore <= resource.data.engagementScore + 2 &&
            request.resource.data.engagementScore >= resource.data.engagementScore - 2
          ) ||
          // 3) Comments counter update (+/-1 commentsCount) when comments not locked
          (
            !isMuted() &&
            resource.data.status == 'visible' &&
            resource.data.get('commentsLocked', false) == false &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'commentsCount', 'engagementScore', 'updatedAt'
            ]) &&
            request.resource.data.commentsCount is int &&
            request.resource.data.commentsCount >= 0 &&
            request.resource.data.commentsCount <= resource.data.commentsCount + 1 &&
            request.resource.data.commentsCount >= resource.data.commentsCount - 1 &&
            request.resource.data.engagementScore is int &&
            request.resource.data.engagementScore >= 0 &&
            request.resource.data.engagementScore <= resource.data.engagementScore + 3 &&
            request.resource.data.engagementScore >= resource.data.engagementScore - 3
          ) ||
          // 4) Single-vote Poll transaction bound to posts/{postId}/pollVotes/{uid}
          (
            resource.data.status == 'visible' &&
            resource.data.get('poll', null) != null &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['poll', 'updatedAt']) &&
            !exists(/databases/$(database)/documents/posts/$(postId)/pollVotes/$(request.auth.uid)) &&
            existsAfter(/databases/$(database)/documents/posts/$(postId)/pollVotes/$(request.auth.uid)) &&
            request.resource.data.poll.totalVotes == resource.data.poll.totalVotes + 1
          ) ||
          // 5) Distinct-UID report increment with automatic hide at >= 5 reports
          (
            resource.data.status == 'visible' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'reportsCount', 'status', 'updatedAt'
            ]) &&
            !exists(/databases/$(database)/documents/posts/$(postId)/postReports/$(request.auth.uid)) &&
            existsAfter(/databases/$(database)/documents/posts/$(postId)/postReports/$(request.auth.uid)) &&
            request.resource.data.reportsCount == resource.data.reportsCount + 1 &&
            request.resource.data.status == (request.resource.data.reportsCount >= 5 ? 'hidden' : 'visible')
          )
        )
      );

      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorUid == request.auth.uid);

      function parentPostExists() {
        return exists(/databases/$(database)/documents/posts/$(postId));
      }
      function parentPostData() {
        return get(/databases/$(database)/documents/posts/$(postId)).data;
      }
      function parentPostExistsAfter() {
        return existsAfter(/databases/$(database)/documents/posts/$(postId));
      }
      function parentPostDataAfter() {
        return getAfter(/databases/$(database)/documents/posts/$(postId)).data;
      }

      // Compressed WebP image subdocuments (keeps parent post < 1MB)
      match /media/{mediaIdx} {
        allow read: if true;
        allow create, update: if isAdmin() || (
          isAuthenticated() &&
          !isBlocked() &&
          !isMuted() &&
          mediaIdx in ['0', '1', '2', '3'] &&
          request.resource.data.authorUid == request.auth.uid &&
          isValidMediaUrl(request.resource.data.dataUrl, false) &&
          parentPostExistsAfter() &&
          parentPostDataAfter().authorUid == request.auth.uid
        );
        allow delete: if isAdmin() || (
          isAuthenticated() && (
            resource.data.get('authorUid', '') == request.auth.uid ||
            (parentPostExists() && parentPostData().authorUid == request.auth.uid)
          )
        );
      }

      // Reactions / Likes per user
      match /likes/{uid} {
        allow read: if true;
        allow create, update: if isAuthenticated() &&
                              !isBlocked() &&
                              request.auth.uid == uid &&
                              request.resource.data.uid == uid &&
                              request.resource.data.reaction in ['like', 'love', 'haha', 'wow', 'fire'];
        allow delete: if isAdmin() ||
                      (isAuthenticated() && request.auth.uid == uid) ||
                      (isAuthenticated() && parentPostExists() && parentPostData().authorUid == request.auth.uid);
      }

      // 1-vote-per-user Poll guard
      match /pollVotes/{uid} {
        allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
        allow create: if isAuthenticated() &&
                      !isBlocked() &&
                      request.auth.uid == uid &&
                      request.resource.data.uid == uid &&
                      request.resource.data.optionIndex is int &&
                      request.resource.data.optionIndex >= 0 &&
                      request.resource.data.optionIndex < 4;
        allow update: if false;
        allow delete: if isAdmin() ||
                      (isAuthenticated() && parentPostExists() && parentPostData().authorUid == request.auth.uid);
      }

      // Distinct-UID Report guard for auto-hide threshold (5)
      match /postReports/{uid} {
        allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == uid);
        allow create: if isAuthenticated() &&
                      !isBlocked() &&
                      request.auth.uid == uid &&
                      request.resource.data.reporterUid == uid;
        allow update: if false;
        allow delete: if isAdmin() ||
                      (isAuthenticated() && parentPostExists() && parentPostData().authorUid == request.auth.uid);
      }

      // Post comments + likes + 1-level replies
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
                      !isBlocked() &&
                      !isMuted() &&
                      request.resource.data.uid == request.auth.uid &&
                      request.resource.data.text is string &&
                      request.resource.data.text.size() > 0 &&
                      request.resource.data.text.size() <= 800 &&
                      (!parentPostExists() || parentPostData().get('commentsLocked', false) == false || isAdmin());
        allow update: if isAdmin() || (
          isAuthenticated() &&
          !isBlocked() &&
          (
            (resource.data.uid == request.auth.uid &&
             !isMuted() &&
             request.resource.data.uid == resource.data.uid &&
             request.resource.data.text is string &&
             request.resource.data.text.size() > 0 &&
             request.resource.data.text.size() <= 800) ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'replyCount'])
          )
        );
        allow delete: if isAdmin() ||
                      (isAuthenticated() && resource.data.uid == request.auth.uid) ||
                      (isAuthenticated() && parentPostExists() && parentPostData().authorUid == request.auth.uid);

        match /likes/{uid} {
          allow read: if true;
          allow create, delete: if isAdmin() ||
                                (isAuthenticated() && !isBlocked() && request.auth.uid == uid) ||
                                (isAuthenticated() && parentPostExists() && parentPostData().authorUid == request.auth.uid);
        }

        match /replies/{replyId} {
          allow read: if true;
          allow create: if isAuthenticated() &&
                        !isBlocked() &&
                        !isMuted() &&
                        request.resource.data.uid == request.auth.uid &&
                        request.resource.data.text is string &&
                        request.resource.data.text.size() > 0 &&
                        request.resource.data.text.size() <= 800 &&
                        (!parentPostExists() || parentPostData().get('commentsLocked', false) == false || isAdmin());
          allow update: if isAdmin() || (
            isAuthenticated() &&
            !isBlocked() &&
            (
              (resource.data.uid == request.auth.uid &&
               !isMuted() &&
               request.resource.data.uid == resource.data.uid &&
               request.resource.data.text is string &&
               request.resource.data.text.size() > 0 &&
               request.resource.data.text.size() <= 800) ||
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
            )
          );
          allow delete: if isAdmin() ||
                        (isAuthenticated() && resource.data.uid == request.auth.uid) ||
                        (isAuthenticated() && parentPostExists() && parentPostData().authorUid == request.auth.uid);

          match /likes/{uid} {
            allow read: if true;
            allow create, delete: if isAdmin() ||
                                  (isAuthenticated() && !isBlocked() && request.auth.uid == uid) ||
                                  (isAuthenticated() && parentPostExists() && parentPostData().authorUid == request.auth.uid);
          }
        }
      }
    }

    // Follows Graph
    match /follows/{uid} {
      match /following/{targetUid} {
        allow read: if true;
        allow create, delete: if isAuthenticated() && !isBlocked() && request.auth.uid == uid && uid != targetUid;
      }
      match /followers/{followerUid} {
        allow read: if true;
        allow create, delete: if isAuthenticated() && !isBlocked() && request.auth.uid == followerUid && uid != followerUid;
      }
    }

    // Saved Bookmarks per User
    match /bookmarks/{uid}/posts/{postId} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid && !isBlocked();
    }

    // Open Theme Submissions (any non-blocked authenticated user; admin approves/rejects)
    match /submissions/{submissionId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.publisherUid == request.auth.uid);
      allow create: if isAuthenticated() &&
                    !isBlocked() &&
                    request.resource.data.publisherUid == request.auth.uid &&
                    request.resource.data.status == 'pending' &&
                    request.resource.data.title is string &&
                    request.resource.data.title.size() > 0 &&
                    request.resource.data.title.size() <= 100;
      allow update: if isAdmin() || (
        isAuthenticated() &&
        !isBlocked() &&
        resource.data.publisherUid == request.auth.uid &&
        (resource.data.status == 'pending' || resource.data.status == 'rejected') &&
        request.resource.data.publisherUid == resource.data.publisherUid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 100
      );
      allow delete: if isAdmin() || (
        isAuthenticated() &&
        resource.data.publisherUid == request.auth.uid &&
        resource.data.status != 'approved'
      );
    }

    // Per-user In-App Notifications
    match /notifications/{uid}/items/{notifId} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow update: if isAuthenticated() &&
                    request.auth.uid == uid &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
                    request.resource.data.read == true;
      allow create: if isAdmin() || (
        isAuthenticated() &&
        !isBlocked() &&
        request.resource.data.actorUid == request.auth.uid &&
        request.auth.uid != uid &&
        request.resource.data.type in ['post_like', 'post_comment', 'post_reply', 'post_mention', 'follow'] &&
        request.resource.data.read == false &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 100 &&
        request.resource.data.body is string &&
        request.resource.data.body.size() <= 350 &&
        request.resource.data.keys().hasOnly([
          'type', 'title', 'body', 'actorUid', 'actorName',
          'postId', 'themeId', 'submissionId', 'read', 'createdAt'
        ])
      );
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == uid);
    }

    // Admin Moderation Audit Log
    match /auditLog/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Admin Publish Studio Log (append-only, zero tokens)
    match /publishLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
                    request.resource.data.actorUid == request.auth.uid &&
                    request.resource.data.themeId is string &&
                    request.resource.data.themeName is string &&
                    request.resource.data.status in ['success', 'failed', 'cancelled'] &&
                    request.resource.data.mode in ['new', 'update', 'variant', 'delete', 'version_bump', 'hide', 'show'] &&
                    request.resource.data.createdAt is int;
      allow update, delete: if false;
    }

    // Abuse & Moderation Reports
    match /reports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAuthenticated() &&
                    !isBlocked() &&
                    request.resource.data.reporterUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
